+/// Soft-skipped PacketEntities counts since the last ``reset_packet_ents_skips`` call:
+/// ``{"entity_not_found": N, "malformed_message": M, "total": N+M}``.
+#[pyfunction]
+fn packet_ents_skips() -> HashMap<String, u32> {
+    let (entity_not_found, malformed_message) = packet_ents_skip_counts();
+    HashMap::from([
+        ("entity_not_found".to_string(), entity_not_found),
+        ("malformed_message".to_string(), malformed_message),
+        ("total".to_string(), entity_not_found.saturating_add(malformed_message)),
+    ])
+}
+
+#[pyfunction]
+fn reset_packet_ents_skips() {
+    reset_packet_ents_skips_rust();
+}
+
 #[pymodule]
 fn demoparser2(_py: Python, m: &Bound<'_, PyModule>) -> PyResult<()> {
     m.add_class::<DemoParser>()?;
     m.add_class::<WantedPropState>()?;
+    m.add_function(wrap_pyfunction!(packet_ents_skips, m)?)?;
+    m.add_function(wrap_pyfunction!(reset_packet_ents_skips, m)?)?;
     Ok(())
 }
