+++ b/src/parser/src/second_pass/entities.rs
@@ -16,6 +16,25 @@ use ahash::AHashMap;
 use csgoproto::CsvcMsgPacketEntities;
 use prost::Message;
 
+use std::sync::atomic::{AtomicU32, Ordering};
+
+/// Soft-skipped PacketEntities failures (EntityNotFound / MalformedMessage).
+/// Python reads these via ``demoparser2.packet_ents_skips()`` after a parse.
+pub static PACKET_ENTS_ENTITY_NOT_FOUND_SKIPS: AtomicU32 = AtomicU32::new(0);
+pub static PACKET_ENTS_MALFORMED_SKIPS: AtomicU32 = AtomicU32::new(0);
+
+pub fn reset_packet_ents_skips() {
+    PACKET_ENTS_ENTITY_NOT_FOUND_SKIPS.store(0, Ordering::Relaxed);
+    PACKET_ENTS_MALFORMED_SKIPS.store(0, Ordering::Relaxed);
+}
+
+pub fn packet_ents_skip_counts() -> (u32, u32) {
+    (
+        PACKET_ENTS_ENTITY_NOT_FOUND_SKIPS.load(Ordering::Relaxed),
+        PACKET_ENTS_MALFORMED_SKIPS.load(Ordering::Relaxed),
+    )
+}
+
 const NSERIALBITS: u32 = 17;
 const STOP_READING_SYMBOL: u8 = 39;
 const HUFFMAN_CODE_MAXLEN: u32 = 17;
@@ -53,6 +72,32 @@ enum EntityCmd {
 
 impl<'a> SecondPassParser<'a> {
     pub fn parse_packet_ents(&mut self, bytes: &[u8], is_fullpacket: bool) -> Result<(), DemoParserError> {
+        // Rush / some CS2 demos emit PacketEntities updates demoparser cannot decode.
+        // Soft-skip ONLY EntityNotFound and MalformedMessage for this message (not every
+        // Err): other failures still abort. EntityNotFound is raised before field inserts;
+        // MalformedMessage is the first failure mode on Valve Rush (rush_001). Skipping the
+        // whole message avoids bitstream desync from continuing mid-entity. Counts are
+        // exposed to Python so the API can mark the parse as degraded.
+        match self.parse_packet_ents_inner(bytes, is_fullpacket) {
+            Err(DemoParserError::EntityNotFound) => {
+                let n = PACKET_ENTS_ENTITY_NOT_FOUND_SKIPS.fetch_add(1, Ordering::Relaxed) + 1;
+                if n == 1 || n % 1000 == 0 {
+                    eprintln!("[demoparser] PacketEntities EntityNotFound skipped (total={n})");
+                }
+                Ok(())
+            }
+            Err(DemoParserError::MalformedMessage) => {
+                let n = PACKET_ENTS_MALFORMED_SKIPS.fetch_add(1, Ordering::Relaxed) + 1;
+                if n == 1 || n % 1000 == 0 {
+                    eprintln!("[demoparser] PacketEntities MalformedMessage skipped (total={n})");
+                }
+                Ok(())
+            }
+            other => other,
+        }
+    }
+
+    fn parse_packet_ents_inner(&mut self, bytes: &[u8], is_fullpacket: bool) -> Result<(), DemoParserError> {
         if !self.parse_entities {
             return Ok(());
         }
