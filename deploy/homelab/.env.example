# Copy to deploy/homelab/.env and fill in. Never commit .env.
# Docs: docs/deploy-homelab.md

# --- Current homelab (not read by compose; for reference) ---
# VM: counterstrike, 192.168.4.54, headless Debian 13
# Public API: https://api-site.csgooner.com (NOT api.csgooner.com)
# Edge: host cloudflared (systemd, installed via the Cloudflare dashboard script);
#       Tunnel public hostname api-site.csgooner.com -> http://localhost:8000,
#       which compose publishes as 127.0.0.1:8000. Grey-cloud fallback only:
# HOMELAB_PUBLIC_IP=REPLACE_WITH_HOME_PUBLIC_IP
# HOMELAB_VM_LAN_IP=192.168.4.54

# --- Compose cloudflared sidecar (NOT used on counterstrike) ---
# Only for a stack without host cloudflared (--profile tunnel, service http://api:8000).
# Leave unset when host cloudflared is installed.
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Postgres (compose wires DATABASE_URL for the api service) ---
POSTGRES_DB=csgooners
POSTGRES_USER=csgooners
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# How long db-backup keeps csgooners-*.sql.gz under the csa-pg-backups volume
# BACKUP_KEEP_DAYS=14

# --- Demo upload needs only DATABASE_URL (compose) + SESSION_SECRET. ---
# Steam sign-in/sync additionally needs TOKEN_ENCRYPTION_KEYS + STEAM_WEB_API_KEY;
# Uploads require a Steam sign-in. Anonymous guest uploads are off by default;
# GUEST_UPLOADS=true would open public guest sessions (POST /auth/guest). Leave off.
# GUEST_UPLOADS=false
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=REPLACE_WITH_FERNET_KEY
# 32+ random chars
SESSION_SECRET=REPLACE_WITH_32PLUS_CHAR_SESSION_SECRET
# https://steamcommunity.com/dev/apikey, domain csgooner.com. Account must have
# spent $5+ (limited accounts can't get keys). Steps: docs/deploy-homelab.md
# "Steam Web API key". Paste the real key in .env only; never commit it.
STEAM_WEB_API_KEY=REPLACE_WITH_STEAM_WEB_API_KEY

# --- Public URLs (must match DNS + frontend) ---
PUBLIC_API_URL=https://api-site.csgooner.com
FRONTEND_URL=https://csgooner.com
ALLOWED_ORIGINS=https://csgooner.com,https://www.csgooner.com,http://localhost:5173,http://127.0.0.1:5173

# --- Optional: Steam demo bot (uploads work without it; sync needs it) ---
# STEAM_BOT_REFRESH_TOKEN=
# Or mount a file and set:
# STEAM_BOT_REFRESH_TOKEN_FILE=/run/secrets/steam-bot-refresh-token

# --- Optional tuning (defaults match render.yaml / docs/deploy-render.md) ---
# AUTO_SYNC_INTERVAL_SECONDS=1800
# SYNC_MAX_MATCHES_PER_REQUEST=3
# Tunnel / Cloudflare proxy ~100 MB request body cap → use 100000000 on Option A.
# Raise to 1073741824 only on Caddy/nginx grey-cloud fallback (Options B/C).
UPLOAD_MAX_BYTES=100000000
# DEMO_PARSE_THREADS=2
