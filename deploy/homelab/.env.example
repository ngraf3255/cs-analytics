# Copy to deploy/homelab/.env and fill in. Never commit .env.
# Docs: docs/deploy-homelab.md

# --- Homelab address placeholders (document in Cloudflare; not read by compose) ---
# Prefer Cloudflare Tunnel (no public IP needed). Only set these for grey-cloud + DDNS.
# HOMELAB_PUBLIC_IP=REPLACE_WITH_HOME_PUBLIC_IP
# HOMELAB_VM_LAN_IP=REPLACE_WITH_VM_LAN_IP

# --- Cloudflare Tunnel (recommended default edge; compose --profile tunnel) ---
# Create tunnel + public hostname api.csgooner.com → http://api:8000 in Zero Trust,
# then paste the install token here:
# CLOUDFLARE_TUNNEL_TOKEN=

# --- Postgres (compose wires DATABASE_URL for the api service) ---
POSTGRES_DB=csgooners
POSTGRES_USER=csgooners
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
# How long db-backup keeps csgooners-*.sql.gz under the csa-pg-backups volume
# BACKUP_KEEP_DAYS=14

# --- Required for Steam features (API refuses to start Steam if incomplete) ---
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEYS=REPLACE_WITH_FERNET_KEY
# 32+ random chars
SESSION_SECRET=REPLACE_WITH_32PLUS_CHAR_SESSION_SECRET
STEAM_WEB_API_KEY=REPLACE_WITH_STEAM_WEB_API_KEY

# --- Public URLs (must match DNS + frontend) ---
PUBLIC_API_URL=https://api.csgooner.com
FRONTEND_URL=https://csgooner.com
ALLOWED_ORIGINS=https://csgooner.com,https://www.csgooner.com,http://localhost:5173,http://127.0.0.1:5173

# --- Optional: Steam demo bot (uploads work without it; sync needs it) ---
# STEAM_BOT_REFRESH_TOKEN=
# Or mount a file and set:
# STEAM_BOT_REFRESH_TOKEN_FILE=/run/secrets/steam-bot-refresh-token

# --- Optional tuning (defaults match render.yaml / docs/deploy-render.md) ---
# AUTO_SYNC_INTERVAL_SECONDS=1800
# SYNC_MAX_MATCHES_PER_REQUEST=3
# Tunnel / Cloudflare proxy ~100 MB request body cap → use 100000000 on Option A.
# Raise to 1073741824 only on Caddy/nginx grey-cloud fallback (Options B/C).
UPLOAD_MAX_BYTES=100000000
# DEMO_PARSE_THREADS=2
