# Optional non-Docker unit. Assumes:
#   - repo at /opt/cs-analytics
#   - venv at /opt/cs-analytics/.venv
#   - Postgres on localhost (same VM), listening on 127.0.0.1 only
#   - secrets in /etc/cs-analytics/api.env (mode 0600)
#   - reverse proxy (Caddy/nginx) or tunnel fronts https://api.csgooner.com → 127.0.0.1:8000
#
# Install:
#   sudo cp deploy/homelab/cs-analytics-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cs-analytics-api

[Unit]
Description=CS Analytics prediction API (homelab)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=csa
Group=csa
WorkingDirectory=/opt/cs-analytics/services/prediction_api
EnvironmentFile=/etc/cs-analytics/api.env
Environment=MODEL_PATH=/opt/cs-analytics/model.pkl
Environment=UPLOAD_JOB_DIR=/var/lib/csa/upload-jobs
Environment=PORT=8000
ExecStartPre=/opt/cs-analytics/.venv/bin/python -m steamlink.migrate --if-configured
# proxy-headers: trust X-Forwarded-* from local Caddy/nginx or a shared lab proxy.
# Tighten --forwarded-allow-ips to the proxy's IP if the API is bound beyond loopback.
ExecStart=/opt/cs-analytics/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips='*'
Restart=on-failure
RestartSec=5
# Demo parse child can use a lot of file-backed memory; leave headroom on 8 GB VM.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
