# TLS termination for api-site.csgooner.com when the VM has public 80/443.
# NOT used on counterstrike: host cloudflared (systemd) is the edge there.
# Prefer Cloudflare Tunnel as the default edge:
# grey-cloud A records expose the home WAN IP and need DDNS on residential links.
# Use this Caddy service only as a fallback for large .dem uploads that exceed
# Cloudflare proxy limits (Free/Pro ~100 MB).
#
# Host-installed cloudflared (current setup) uses http://localhost:8000; the
# unused compose sidecar would use http://api:8000. Neither needs this file.

api-site.csgooner.com {
	encode gzip
	reverse_proxy api:8000

	# Allow full-length demos (API default UPLOAD_MAX_BYTES = 1 GiB).
	request_body {
		max_size 1GB
	}
}
