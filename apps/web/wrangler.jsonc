{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cs-analytics",
  "compatibility_date": "2026-10-04",
  "main": "./worker/index.js",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "csgooner.com",
      "custom_domain": true
    },
    {
      "pattern": "www.csgooner.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  }
}
